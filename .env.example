# Copy to .env (never commit .env). Use Neon's *pooled* connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
USER_AGENT=T20NewsIntelBot/0.1 (academic project; contact: you@example.com)
CRAWL_DELAY_SECONDS=2

# Crawler
CRAWLER_STORE=local            # local (data/*.jsonl) or neon
CRAWLER_MAX_ARTICLES=3000      # rolling cap: oldest-added articles are deleted beyond this
